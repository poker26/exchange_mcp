# Exchange server (EWS)
EXCHANGE_HOST=mail.inplatlabs.ru
EXCHANGE_USER=OFFICE\oleg.pokrovskiy
EXCHANGE_PASSWORD=change-me
EXCHANGE_EMAIL=oleg.pokrovskiy@inplatlabs.ru
EWS_URL=https://mail.inplatlabs.ru/EWS/Exchange.asmx
SSL_VERIFY=false

# Seconds to cache exchange_list_folders (reduces EWS load)
EWS_FOLDERS_CACHE_TTL=300
CALENDAR_TIMEZONE=Europe/Moscow
# Comma-separated internal SMTP domains for contact search preference
ORG_ACCEPTED_DOMAINS=fin-frame.ru,inplatlabs.ru,instant-pay.ru

# State persistence (cursors, Message-ID LRU)
STATE_DIR=/app/state

# MCP server auth
MCP_API_KEY=change-me-to-a-long-random-string
SERVER_HOST=0.0.0.0
SERVER_PORT=8903
LOG_LEVEL=INFO
PUBLIC_URL=

# Optional MinIO — transit storage for email attachments (presigned URLs for Telegram)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=exchange-mail-transit
MINIO_SECURE=false
MINIO_PRESIGN_TTL_SECONDS=86400
